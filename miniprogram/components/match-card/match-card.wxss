.match-card {
  box-sizing: border-box;
  margin-bottom: 20rpx;
  padding: 25rpx;
  border: 1rpx solid rgba(135, 165, 149, 0.17);
  border-radius: 26rpx;
  background: rgba(16, 33, 24, 0.92);
  box-shadow: 0 20rpx 48rpx rgba(0, 0, 0, 0.18);
}

.match-meta,
.pick-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #82968b;
  font-size: 21rpx;
}

.teams-row {
  display: grid;
  grid-template-columns: 1fr 54rpx 1fr;
  align-items: center;
  margin: 28rpx 0;
}

.team {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  color: #f4f7f5;
  font-size: 22rpx;
  text-align: center;
}

.team-badge {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: #166534;
  color: #dcfce7;
  font-weight: 800;
}

.team-badge.away {
  background: #1e3a5f;
  color: #dbeafe;
}

.versus {
  color: #5f7569;
  font-size: 20rpx;
  text-align: center;
}

.probabilities {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.probability-item {
  padding: 13rpx 8rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.04);
  color: #8fa299;
  font-size: 19rpx;
  text-align: center;
}

.probability-item text {
  display: block;
}

.probability-item text:last-child {
  margin-top: 5rpx;
  color: #facc15;
  font-size: 23rpx;
  font-weight: 750;
}

.pick-row {
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(135, 165, 149, 0.14);
}

.pick-value {
  color: #86efac;
  font-weight: 700;
}

