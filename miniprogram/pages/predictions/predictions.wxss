.tabs {
  display: flex;
  gap: 14rpx;
  margin: 30rpx 0 24rpx;
}

.tab {
  padding: 14rpx 24rpx;
  border: 1rpx solid rgba(135, 165, 149, 0.18);
  border-radius: 999rpx;
  color: #82968b;
  font-size: 22rpx;
}

.tab.active {
  border-color: rgba(34, 197, 94, 0.6);
  background: rgba(34, 197, 94, 0.14);
  color: #86efac;
}

