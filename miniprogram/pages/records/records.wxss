.summary-card {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-top: 32rpx;
  padding: 30rpx;
}

.accuracy-ring {
  display: flex;
  width: 150rpx;
  height: 150rpx;
  flex-shrink: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 12rpx solid rgba(34, 197, 94, 0.24);
  border-top-color: #22c55e;
  border-radius: 50%;
}

.accuracy-ring text:first-child {
  color: #facc15;
  font-size: 34rpx;
  font-weight: 800;
}

.accuracy-ring text:last-child {
  margin-top: 3rpx;
  color: #82968b;
  font-size: 18rpx;
}

.summary-grid {
  display: grid;
  flex: 1;
  grid-template-columns: repeat(3, 1fr);
}

.summary-grid view,
.summary-grid text {
  display: block;
  text-align: center;
}

.summary-grid text:first-child {
  font-size: 29rpx;
  font-weight: 800;
}

.summary-grid text:last-child {
  margin-top: 8rpx;
  color: #82968b;
  font-size: 18rpx;
}

.summary-grid .success {
  color: #4ade80;
}

.summary-grid .failure {
  color: #fb7185;
}

.record-card {
  margin-bottom: 18rpx;
  padding: 22rpx 24rpx;
}

.record-date {
  color: #72877c;
  font-size: 19rpx;
}

.record-match {
  display: grid;
  grid-template-columns: 1fr 100rpx 1fr;
  align-items: center;
  margin: 20rpx 0;
  font-size: 22rpx;
  text-align: center;
}

.score {
  color: #f8fafc;
  font-size: 28rpx;
  font-weight: 800;
}

.record-result {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(135, 165, 149, 0.13);
  color: #82968b;
  font-size: 20rpx;
}

.result-tag {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 700;
}

.result-tag.hit {
  background: rgba(34, 197, 94, 0.14);
  color: #4ade80;
}

.result-tag.miss {
  background: rgba(244, 63, 94, 0.13);
  color: #fb7185;
}

