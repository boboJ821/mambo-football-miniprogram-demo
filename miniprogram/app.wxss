page {
  min-height: 100%;
  background: #07120d;
  color: #f4f7f5;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  background:
    radial-gradient(circle at 88% 6%, rgba(34, 197, 94, 0.17), transparent 32%),
    linear-gradient(180deg, #08150e 0%, #07120d 100%);
}

.eyebrow {
  color: #22c55e;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
}

.page-title {
  display: block;
  margin-top: 12rpx;
  font-size: 52rpx;
  line-height: 1.15;
  font-weight: 800;
}

.page-subtitle {
  display: block;
  margin-top: 14rpx;
  color: #8fa299;
  font-size: 25rpx;
  line-height: 1.65;
}

.section-title {
  display: block;
  margin: 42rpx 0 20rpx;
  font-size: 30rpx;
  font-weight: 750;
}

.surface-card {
  box-sizing: border-box;
  border: 1rpx solid rgba(135, 165, 149, 0.17);
  border-radius: 26rpx;
  background: rgba(16, 33, 24, 0.92);
  box-shadow: 0 20rpx 48rpx rgba(0, 0, 0, 0.18);
}

